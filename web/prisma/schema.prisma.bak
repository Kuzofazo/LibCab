generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Added for Auth
  name      String?
  phone     String?
  role      String   @default("RIDER") // RIDER, DRIVER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  driverProfile DriverProfile?
  ridesAsRider  Ride[]         @relation("RiderRides")
  reviews       Review[]
}

model DriverProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  vehicleModel    String?
  licensePlate    String?
  rating          Float    @default(5.0)
  isOnline        Boolean  @default(false)
  currentLat      Float?
  currentLng      Float?
  
  rides           Ride[]
}

model Ride {
  id              String   @id @default(cuid())
  riderId         String
  rider           User     @relation("RiderRides", fields: [riderId], references: [id])
  driverId        String?
  driver          DriverProfile? @relation("DriverRides", fields: [driverId], references: [id])
  
  status          String   @default("REQUESTED") // REQUESTED, ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED
  paymentStatus   String   @default("PENDING")   // PENDING, PAID
  
  originAddress   String
  destAddress     String
  originLat       Float     @default(0)
  originLng       Float     @default(0)
  destLat         Float     @default(0)
  destLng         Float     @default(0)
  
  vehicleType     String?
  distance        Float?
  fare            Float?
  
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  
  review          Review?
}

model Review {
  id        String   @id @default(cuid())
  rideId    String   @unique
  ride      Ride     @relation(fields: [rideId], references: [id])
  userId    String   // Who wrote the review
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
