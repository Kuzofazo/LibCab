{
  "expo": {
    "name": "AfriCab",
    "slug": "africab-mobile",
    "scheme": "africab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D32F2F"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBMK-zDtqR4S1WxOltsyea2lwQnvv8D6SI"
      },
      "bundleIdentifier": "com.africab.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.africab.mobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCp08LOWmXg0M6M1ONnfxjukFO-0OoWQpQ"
        }
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}